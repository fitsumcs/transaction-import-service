{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "Console": {
      "FormatterName": "json",
      "FormatterOptions": {
        "IncludeScopes": true,
        "UseUtcTimestamp": true,
        "TimestampFormat": "yyyy-MM-ddTHH:mm:ss.fffZ"
      }
    }
  },
  "AllowedHosts": "*",
  "Postgres": {
    "ConnectionString": ""
  },
  "Redis": {
    "ConnectionString": ""
  },
  "FileStorage": {
    "Provider": "local",
    "LocalRoot": "/data/uploads"
  },
  "Imports": {
    "MaxFileBytes": 268435456,
    "MaxProcessingAttempts": 3,
    "MaxRejectionPageSize": 200,
    "SummaryTopGroups": 20
  },
  "Processing": {
    "BatchSize": 1000,
    "MaxLineBytes": 32768,
    "MaxConcurrentImports": 2,
    "PrefetchBatches": 2,
    "LeaseDuration": "00:01:00",
    "HeartbeatInterval": "00:00:15"
  },
  "RiskScoring": {
    "WorkerCount": 0,
    "MaxQueuedRequests": 4000,
    "ChunkSize": 64
  },
  "Retry": {
    "MaxAttempts": 5,
    "BaseDelay": "00:00:00.100",
    "MaxDelay": "00:00:05"
  }
}
