<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsTestProject>true</IsTestProject>
    <!-- CA1707: test method names use underscores. CA2007: ConfigureAwait is noise in tests.
         CA2022: partial ReadAsync results are intentional when asserting exceptions. -->
    <NoWarn>$(NoWarn);CA1707;CA2007;CA2022</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
