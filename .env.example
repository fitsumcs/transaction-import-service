# Copy to .env to override defaults used by docker-compose.yml. Never commit .env.
POSTGRES_DB=transaction_import
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
API_PORT=8080
WORKER_PORT=8081

# File storage (default: local volume). For Cloudinary free tier set:
# FileStorage__Provider=cloudinary
# FileStorage__CloudName=your_cloud_name
# FileStorage__ApiKey=your_api_key
# FileStorage__ApiSecret=your_api_secret
# FileStorage__CloudinaryFolder=transaction-import

# Production — on the server only need docker-compose.prod.yml + this .env
# at /usr/src/apps/transaction-import (local still uses docker-compose.yml --build):
# IMAGE_API=ghcr.io/fitsumcs/transaction-import-service/api:latest
# IMAGE_WORKER=ghcr.io/fitsumcs/transaction-import-service/worker:latest
# IMAGE_MIGRATOR=ghcr.io/fitsumcs/transaction-import-service/migrator:latest
# Then: docker login ghcr.io  # if packages are private
#       docker compose -f docker-compose.prod.yml pull
#       docker compose -f docker-compose.prod.yml up -d
