# Copy to .env to override defaults used by docker-compose.yml. Never commit .env.
POSTGRES_DB=transaction_import
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
API_PORT=8080
WORKER_PORT=8081

# File storage (default: local volume). For Cloudinary free tier set:
# FileStorage__Provider=cloudinary
# FileStorage__CloudName=your_cloud_name
# FileStorage__ApiKey=your_api_key
# FileStorage__ApiSecret=your_api_secret
# FileStorage__CloudinaryFolder=transaction-import

# Production (docker-compose.prod.yml / CD):
# IMAGE_API=ghcr.io/<owner>/<repo>/api:latest
# IMAGE_WORKER=ghcr.io/<owner>/<repo>/worker:latest
# IMAGE_MIGRATOR=ghcr.io/<owner>/<repo>/migrator:latest
