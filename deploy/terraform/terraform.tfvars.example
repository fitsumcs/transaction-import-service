aws_region          = "us-east-1"
project_name        = "transaction-import"
instance_type       = "t3.micro"

# Required: path to YOUR public key (AWS key pair).
ssh_public_key_path = "~/.ssh/id_ed25519.pub"

# Optional but needed for enable_https remote-exec:
ssh_private_key_path = "~/.ssh/id_ed25519"

# Lock SSH to your IP when possible, e.g. "203.0.113.10/32"
allowed_ssh_cidr = "0.0.0.0/0"

# DuckDNS (https://www.duckdns.org) — create subdomain + copy token
duckdns_subdomain = "abzlab-import"          # → abzlab-import.duckdns.org
duckdns_token     = "PASTE_DUCKDNS_TOKEN"
domain_name       = "abzlab-import.duckdns.org"

# Issue Let's Encrypt cert after create (needs domain_name + private key + email)
enable_https  = true
certbot_email = "you@example.com"

app_dir = "/usr/src/apps/transaction-import"
